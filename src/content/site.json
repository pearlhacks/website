  "about": {
    "title": "What is Pearl Hacks?",
    "paragraphs": [
      "Pearl Hacks is a hackathon that celebrates women and gender-nonconforming individuals in tech. In alignment with university guidelines, the event is open to all participants, while maintaining a supportive environment that centers historically underrepresented genders in technology. We especially cater to first-time hackers who are looking for a supportive environment to explore technology.",
      "Participants work in teams to create incredible projects in 24 hours with the help of excellent mentors, workshops, and tech talks. All the while, they’ll get to meet some fantastic people, enjoy fun games, collect swag, and eat free food."
    ],
    "inclusivity": {
      "title": "Inclusivity statement",
      "body": "Pearl Hacks is an event designed to uplift and center women and gender non-conforming individuals in tech. We expect all of our mentors, volunteers, participants, directors, sponsors, judges, and visitors to be respectful of our participants’ gender identities and expressions."
    },
    "links": [
      { "label": "Our story", "href": "https://maeganclawges.com/web/pearlhacks.html" },
      { "label": "Past projects", "href": "https://pearlhacks2025.devpost.com/" }
    ]
  },
  "programs": {
    "title": "Programs",
    "intro": "Tracks are where your project competes for prizes. Focus Pathways add workshops, resources and mentorship in one area of tech, and don’t have prizes of their own.",
    "items": [
      {
        "label": "Track",
        "title": "General Track",
        "body": "For all hackers, from seasoned coders to first-time builders. Bring any idea to life with software, hardware, design, or a mix of all three.",
        "points": [
          "Everyone is automatically entered.",
          "You can also submit to sponsor challenges.",
          "Eligible for 1st, 2nd and 3rd place prizes."
        ]
      },
      {
        "label": "Track",
        "title": "Beginner Track",
        "body": "New to hackathons or computer science? Get beginner-friendly workshops, resources and mentorship to build confidence and explore how computing connects with your passions.",
        "points": [
          "For hackers new to hackathons and/or computer science.",
          "You can still enter sponsor challenges.",
          "Eligible for the dedicated Beginner Track Prize."
        ]
      },
      {
        "label": "Focus Pathway",
        "title": "UX/UI Focus Pathway",
        "body": "For hackers who love design and user experience. Learn tools like Figma and web design principles through guided workshops and hands-on sessions.",
        "points": [
          "Open to everyone, no experience needed.",
          "Exclusive UX/UI workshops.",
          "Sponsor challenges and the General Track still apply; no separate prize."
        ]
      },
      {
        "label": "Focus Pathway",
        "title": "AI Focus Pathway",
        "body": "Experiment with AI and machine learning, from chatbots to computer vision to natural language processing, through dedicated workshops and mentorship.",
        "points": [
          "AI or machine learning must be a core part of your project.",
          "AI tools can help, but the creativity should be yours.",
          "Sponsor challenges and the General Track still apply; no separate prize."
        ]
      }
    ]
